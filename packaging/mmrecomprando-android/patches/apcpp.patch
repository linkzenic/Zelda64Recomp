+        file(READ ${MBEDTLS_CONFIG_FILE} MBEDTLS_CONFIG)
+        string(REPLACE
+            "#define MBEDTLS_AESCE_C"
+            "/* MBEDTLS_AESCE_C disabled for Android's portable arm64 baseline. */"
+            MBEDTLS_CONFIG
+            "${MBEDTLS_CONFIG}"
+        )
+        file(WRITE ${MBEDTLS_CONFIG_FILE} "${MBEDTLS_CONFIG}")
+    endif()
     set(USE_STATIC_MBEDTLS_LIBRARY ON CACHE BOOL "" FORCE)
-    set(MBEDTLS_INCLUDE_DIRS ${CMAKE_CURRENT_SOURCE_DIR}/mbedtls-3.4.0/include)
+    set(USE_MBED_TLS ON CACHE BOOL "" FORCE)
+    set(MBEDTLS_FOUND TRUE)
+    set(MBEDTLS_INCLUDE_DIRS ${MBEDTLS_SOURCE_DIR}/include)
     set(MBEDTLS_VERSION_GREATER_THAN_3 ${MBEDTLS_INCLUDE_DIRS})
     set(MBEDTLS_LIBRARY mbedtls)
     set(MBEDX509_LIBRARY mbedx509)
     set(MBEDCRYPTO_LIBRARY mbedcrypto)
-    add_subdirectory(${CMAKE_BINARY_DIR}/mbedtls-3.4.0 mbedtls_bin)
-endif (WIN32 AND USE_TLS)
+    set(MBEDTLS_LIBRARIES mbedtls mbedx509 mbedcrypto)
+    add_compile_definitions(IXWEBSOCKET_USE_MBED_TLS_MIN_VERSION_3)
+    add_subdirectory(${MBEDTLS_SOURCE_DIR} mbedtls_bin)
+    if (ANDROID)
+        target_compile_options(mbedcrypto PRIVATE -Wno-documentation)
+        target_compile_options(mbedx509 PRIVATE -Wno-documentation)
+        target_compile_options(mbedtls PRIVATE -Wno-documentation)
