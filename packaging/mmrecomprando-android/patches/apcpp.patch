+
+# Windows and Android use the bundled mbedTLS source archive.
+if ((WIN32 OR ANDROID) AND USE_TLS)
+    set(MBEDTLS_SOURCE_DIR ${CMAKE_CURRENT_BINARY_DIR}/mbedtls-3.4.0)
+    execute_process(COMMAND ${CMAKE_COMMAND} -E remove_directory ${MBEDTLS_SOURCE_DIR})
+    execute_process(
+        COMMAND ${CMAKE_COMMAND} -E tar xzf ${CMAKE_CURRENT_SOURCE_DIR}/mbedtls-3.4.0.tar.gz
+        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
+        RESULT_VARIABLE MBEDTLS_EXTRACT_RESULT
