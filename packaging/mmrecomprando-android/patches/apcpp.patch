diff --git a/Archipelago.cpp b/Archipelago.cpp
--- a/Archipelago.cpp
+++ b/Archipelago.cpp
@@ -211,17 +211,33 @@ void AP_Init(AP_State* state, const char* ip, const char* game, const char* play
         ix::initNetSystem();
         firstInit = true;
     }
-    state->webSocket.setUrl("wss://" + state->ap_ip);
+    const std::string ws_prefix = "ws://";
+    const std::string wss_prefix = "wss://";
+    const bool explicit_ws = state->ap_ip.rfind(ws_prefix, 0) == 0;
+    const bool explicit_wss = state->ap_ip.rfind(wss_prefix, 0) == 0;
+    const std::string websocket_url =
+        (explicit_ws || explicit_wss) ? state->ap_ip : wss_prefix + state->ap_ip;
+    const std::string cleartext_url =
+        explicit_wss ? ws_prefix + state->ap_ip.substr(wss_prefix.size())
+                     : (explicit_ws ? state->ap_ip : ws_prefix + state->ap_ip);
+    state->isSSL = !explicit_ws;
+    state->webSocket.setUrl(websocket_url);
     state->webSocket.setOnMessageCallback([=](const ix::WebSocketMessagePtr& msg)
         {
             if (msg->errorInfo.retries >= MAX_RETRIES) {
+#if defined(__ANDROID__)
+                // Never downgrade a secure Android connection implicitly. Local
+                // servers remain available when the user explicitly enters ws://.
+                state->notfound = true;
+#else
                 if (/*msg->errorInfo.retries-1 >= 1 && */state->isSSL) {
                     //printf("AP: SSL connection failed. Attempting encrypted...\n");
-                    state->webSocket.setUrl("ws://" + state->ap_ip);
+                    state->webSocket.setUrl(cleartext_url);
                     state->isSSL = false;
                 } else if (msg->errorInfo.retries >= 2*MAX_RETRIES) {
                     state->notfound = true;
                 }
+#endif
             }
             if (msg->type == ix::WebSocketMessageType::Message)
             {
@@ -694,7 +710,7 @@ void AP_DeathLinkSend(AP_State* state) {
     std::chrono::time_point<std::chrono::system_clock> timestamp = std::chrono::system_clock::now();
