+# Enable TLS on every supported platform.
 set(USE_TLS ON CACHE BOOL "Enable TLS support" FORCE)
-if (WIN32 AND USE_TLS)
-    execute_process(COMMAND ${CMAKE_COMMAND} -E remove -f mbedtls-3.4.0)
